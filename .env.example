# Salin file ini menjadi .env, lalu isi nilainya sesuai lingkungan Anda.
# Jangan pernah menyimpan .env yang berisi kredensial asli ke Git.

# Alamat server MySQL. Gunakan 127.0.0.1 untuk MySQL lokal.
DB_HOST=127.0.0.1

# Port MySQL. Biarkan 3306 jika memakai port bawaan.
DB_PORT=3306

# Nama pengguna MySQL yang memiliki akses ke database aplikasi.
DB_USER=nama_pengguna_database

# Kata sandi untuk pengguna MySQL di atas.
DB_PASS=kata_sandi_database

# Nama database DOREMI yang akan digunakan aplikasi.
DB_DATABASE=nama_database_doremi

# Zona waktu PHP dalam format IANA, misalnya Asia/Jakarta.
APP_TIMEZONE=Asia/Jakarta

# Prefix URL saat aplikasi dipasang di subfolder.
# Isi kosong jika aplikasi dipasang langsung di root domain.
APP_BASE_PATH=/doremi-app

# Client ID OAuth 2.0 dari Google Cloud untuk fitur login Google.
GOOGLE_CLIENT_ID=isi_dengan_google_client_id

# Client secret OAuth 2.0 dari Google Cloud. Jaga nilai ini tetap rahasia.
GOOGLE_CLIENT_SECRET=isi_dengan_google_client_secret

# URL callback yang harus sama persis dengan Authorized redirect URI di Google Cloud.
# Sesuaikan host dan APP_BASE_PATH dengan lingkungan Anda.
GOOGLE_CALLBACK_URL=http://localhost/doremi-app/auth/callback.php
